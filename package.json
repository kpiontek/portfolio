{
  "name": "kyle-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist/server && node scripts/prerender.mjs",
    "build:client": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "test": "vitest run",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "knip": "^6.35.1",
    "lefthook": "^2.1.12",
    "playwright": "1.62.1",
    "prettier": "^3.9.6",
    "sass": "^1.104.0",
    "sharp": "^0.35.4",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
