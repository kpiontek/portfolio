{
  "name": "kyle-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist/server && node scripts/prerender.mjs",
    "build:client": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "test": "vitest run",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "contours": "node scripts/contours.mjs",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "d3-contour": "^4.0.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "knip": "^6.40.0",
    "lefthook": "^2.1.17",
    "playwright": "1.63.0",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "sharp": "^0.35.5",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
